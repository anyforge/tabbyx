//- Collapsed sidebar: icon rail only
.collapsed-bar.h-100.d-flex.flex-column.align-items-center(*ngIf='sidebarCollapsed')
    button.icon-btn(
        (click)='toggleSidebar()',
        [ngbTooltip]='"Show connections"|translate',
        container='body',
        placement='right'
    )
        i.fas.fa-fw.fa-angles-right

    .collapsed-divider

    button.icon-btn(
        (click)='newProfile()',
        [ngbTooltip]='"New connection"|translate',
        container='body',
        placement='right'
    )
        i.fas.fa-fw.fa-plus

    button.icon-btn(
        (click)='newGroup()',
        [ngbTooltip]='"New folder"|translate',
        container='body',
        placement='right'
    )
        i.fas.fa-fw.fa-folder-plus

//- Expanded sidebar
.tree-panel.h-100.d-flex.flex-column(*ngIf='!sidebarCollapsed')
    .tree-toolbar.d-flex.align-items-center(
        (contextmenu)='rootContextMenu($event)'
    )
        span.tree-title.me-auto(translate) Connections

        button.icon-btn(
            (click)='newProfile()',
            [ngbTooltip]='"New connection"|translate',
            container='body'
        )
            i.fas.fa-fw.fa-plus

        button.icon-btn(
            (click)='newGroup()',
            [ngbTooltip]='"New folder"|translate',
            container='body'
        )
            i.fas.fa-fw.fa-folder-plus

        button.icon-btn(
            (click)='toggleSidebar()',
            [ngbTooltip]='"Collapse sidebar"|translate',
            container='body'
        )
            i.fas.fa-fw.fa-angles-left

    input.form-control.form-control-sm.tree-filter(
        type='text',
        [(ngModel)]='filter',
        [placeholder]='"Filter"|translate',
        (ngModelChange)='onFilterChange()'
    )

    .profile-tree
        .d-flex.flex-column.profile-tree-container(
            (contextmenu)='rootContextMenu($event)'
        )

            ng-container(*ngFor='let group of rootGroups')
                ng-container(*ngTemplateOutlet='recursiveGroup; context: {$implicit: group, depth: 0}')

            ng-template(#recursiveGroup let-group let-depth='depth')
                a.tree-item.tree-group(
                    (click)='toggleGroupCollapse(group)',
                    [style.paddingLeft.px]='depth * 16',
                    (contextmenu)='groupContextMenu(group, $event)',
                    href='#'
                )
                    .fw-20
                        .fa.fa-fw.fas.fa-chevron-right.ms-1.text-muted(*ngIf='group.collapsed')
                        .fa.fa-fw.fas.fa-chevron-down.ms-1.text-muted(*ngIf='!group.collapsed')
                    .fw-20
                        profile-icon.ms-1([icon]='group.icon ?? "far fa-folder"', [color]='group?.color')
                    span.item-label.ms-2.me-auto {{ group.name || ("Ungrouped"|translate) }}

                    .actions
                        .action(
                            (click)='$event.preventDefault(); $event.stopPropagation(); newProfile(group)',
                            [ngbTooltip]='"New connection"|translate',
                            container='body'
                        )
                            .fa.fa-fw.fas.fa-plus
                        .action(
                            *ngIf='canAddSubgroup(group)',
                            (click)='$event.preventDefault(); $event.stopPropagation(); newGroup(group)',
                            [ngbTooltip]='"New folder"|translate',
                            container='body'
                        )
                            .fa.fa-fw.fas.fa-folder-plus
                        .action(
                            *ngIf='isUserGroup(group)',
                            (click)='$event.preventDefault(); $event.stopPropagation(); editProfileGroup(group)',
                            [ngbTooltip]='"Edit group"|translate',
                            container='body'
                        )
                            .fa.fa-fw.fas.fa-pen
                        .action.action-danger(
                            *ngIf='isUserGroup(group)',
                            (click)='$event.preventDefault(); $event.stopPropagation(); deleteProfileGroup(group)',
                            [ngbTooltip]='"Delete"|translate',
                            container='body'
                        )
                            .fa.fa-fw.fas.fa-trash

                ng-container(*ngIf='!group.collapsed')
                    ng-container(*ngFor='let profile of group.profiles')
                        a.tree-item(
                            (dblclick)='launchProfile(profile)',
                            [style.paddingLeft.px]='(depth + 1) * 16',
                            (contextmenu)='profileContextMenu(profile, $event)',
                            href='#'
                        )
                            .fw-20
                                profile-icon.ms-1([icon]='profile.icon', [color]='profile.color')
                            span.item-label.ms-2.no-wrap {{ profile.name }}

                            .actions
                                .action(
                                    (click)='$event.preventDefault(); $event.stopPropagation(); launchProfile(profile)',
                                    [ngbTooltip]='"Run"|translate',
                                    container='body'
                                )
                                    .fa.fa-fw.fas.fa-play
                                .action(
                                    *ngIf='!(profile.isBuiltin ?? profile.isTemplate)',
                                    (click)='$event.preventDefault(); $event.stopPropagation(); editProfile(profile)',
                                    [ngbTooltip]='"Edit profile"|translate',
                                    container='body'
                                )
                                    .fa.fa-fw.fas.fa-pen
                                .action.action-danger(
                                    *ngIf='!(profile.isBuiltin ?? profile.isTemplate)',
                                    (click)='$event.preventDefault(); $event.stopPropagation(); deleteProfile(profile)',
                                    [ngbTooltip]='"Delete"|translate',
                                    container='body'
                                )
                                    .fa.fa-fw.fas.fa-trash

                    ng-container(*ngFor='let child of group.children')
                        ng-container(*ngTemplateOutlet='recursiveGroup; context: {$implicit: child, depth: depth + 1}')

.grabber(
    *ngIf='!sidebarCollapsed',
    (mousedown)="startResize($event)"
)
